<Window x:Class="GKRStudio.UI.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Icon="/Assets/app.ico"
        Title="GKR Studio" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" Topmost="True">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,0,0,10" Text="Hazırlanıyor…"/>
        <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" IsIndeterminate="True"/>
        <TextBlock x:Name="EtaText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
        <Expander Header="Ayrıntılar" Foreground="{DynamicResource Muted}" Margin="0,12,0,0">
            <TextBox x:Name="Log" Height="160" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas" FontSize="11"/>
        </Expander>
        <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RevealButton" Content="Klasörde göster" Visibility="Collapsed" Click="Reveal_Click" Style="{StaticResource Primary}"/>
            <Button x:Name="CancelButton" Content="İptal" Click="Cancel_Click" Margin="0,0,0,8"/>
        </WrapPanel>
    </StackPanel>
</Window>
