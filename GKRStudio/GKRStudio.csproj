<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projection: Windows.Data.Pdf (page rendering) and the Windows Share UI. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GKRStudio</AssemblyName>
    <RootNamespace>GKRStudio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.3.9</Version>
    <Product>GKR Studio</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
    <!-- Never embed the local folder path in the binaries: map it to a neutral root and embed the PDB. -->
    <PathMap>$(MSBuildProjectDirectory)=C:\GKRStudio</PathMap>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\make-logo.ps1" />
  </ItemGroup>

  <!-- WinForms is only used for the tray icon (aliased); keep WPF types unambiguous. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="PdfPig" Version="0.1.13" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <PackageReference Include="SharpCompress" Version="0.50.9" />
  </ItemGroup>

</Project>
